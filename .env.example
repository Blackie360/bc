# MySQL connection string used by Drizzle and server-side database access.
# Example for local MySQL:
DATABASE_URL="mysql://bc_user:bc_password@localhost:3306/bc"

# LDAP authentication and directory lookup.
# Use ldap://host:389 or ldaps://host:636. Multiple hosts can be comma-separated.
LDAP_PRIMARY_HOSTS="ldap://ad.example.com:389"
LDAP_PRIMARY_BASE_DN="DC=example,DC=com"
LDAP_PRIMARY_USERNAME="CN=ldap-reader,OU=Service Accounts,DC=example,DC=com"
LDAP_PRIMARY_PASSWORD="change-me"
LDAP_CONNECT_TIMEOUT_MS="5000"
LDAP_TIMEOUT_MS="8000"

# Optional directory search tuning for the role allocation dropdown.
LDAP_DIRECTORY_LOOKUP_ENABLED="true"
LDAP_DIRECTORY_USER_SIZE_LIMIT="200"
# Optional allowed email domains for AD dropdown (comma/space/semicolon separated).
# LDAP_DIRECTORY_EMAIL_DOMAINS="liquid.tech"
# LDAP_DIRECTORY_USER_FILTER="(&(|(objectClass=user)(objectClass=person))(|(mail=*)(userPrincipalName=*)(proxyAddresses=SMTP:*)))"

# Optional local fallback email options for role allocation.
# Set LDAP_DIRECTORY_LOOKUP_ENABLED="false" in local/dev if LDAP is not reachable.
ROLE_ASSIGNMENT_EMAIL_OPTIONS="user@liquid.tech"

# Local development login bypass (development only; never enable in production).
BC_AUTH_DEV_BYPASS="true"
BC_DEV_LOGIN_USERNAME="dev"
BC_DEV_LOGIN_PASSWORD="dev"
BC_APP_USER_DISPLAY_NAME="Local Dev User"
BC_APP_USER_EMAIL="dev@liquid.tech"
BC_APP_USER_ROLE="Account Manager"
JWT_SECRET="change-me"
